{
  "name": "@deckaura/tarot-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for tarot card meanings, readings, and spreads. Powered by Deckaura (https://deckaura.com).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tarot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "validate:mcpb": "npm run build:mcpb && npx --yes @anthropic-ai/mcpb@2.1.2 validate build/mcpb",
    "pack:mcpb": "npm run validate:mcpb && npx --yes @anthropic-ai/mcpb@2.1.2 pack build/mcpb build/deckaura-tarot-mcp-server-1.0.1.mcpb",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tarot",
    "claude",
    "anthropic",
    "ai-tools",
    "divination",
    "deckaura"
  ],
  "author": "Deckaura <hello@deckaura.com> (https://deckaura.com)",
  "homepage": "https://deckaura.com/pages/ai-data-sources",
  "repository": {
    "type": "git",
    "url": "https://github.com/gokimedia/tarot-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/gokimedia/tarot-mcp-server/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.gokimedia/tarot-mcp-server",
  "mcp": {
    "transports": [
      "stdio"
    ],
    "categories": [
      "knowledge",
      "entertainment",
      "reference"
    ]
  }
}
